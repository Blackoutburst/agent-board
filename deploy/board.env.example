# Example environment for a shared board served behind a reverse proxy.
# A local board needs none of this: run `python3 scripts/local_board.py run`.
BOARD_DATA_DIR=/home/ubuntu/.local/share/collaboration-board
BOARD_BASE_URL=https://board.example.com
BOARD_ROOT_PATH=
BOARD_REQUIRE_LOGIN=1
BOARD_OWNERS='{"alice":"Alice","bob":"Bob"}'
# Either verify logins through File Browser (map File Browser user -> owner id) ...
BOARD_FILEBROWSER_URL=
BOARD_FILEBROWSER_MAP='{}'
# ... or set owner passwords with `manage.py owner-password <owner>`.
BOARD_ALLOW_LOCAL_PASSWORDS=0
